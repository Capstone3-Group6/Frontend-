# Copy this file to ".env" for local development:
#   cp .env.example .env
#
# Vite only exposes variables that start with VITE_, and it bakes them into the
# built JavaScript — so NEVER put secrets (passwords, API keys) here. They would
# ship to every visitor's browser.

# The backend API this frontend talks to.
# Local dev: your Express server. Production: your deployed backend URL.
VITE_API_URL=http://localhost:8080


VITE_AUTH0_DOMAIN=dev-auth0domain-goes-here.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id-goes-here

# The backend API this frontend should connect to.
VITE_AUTH0_AUDIENCE=you-custom-api-identifier

