# Copy this file to ".env" for local development:
#   cp .env.example .env
#
# Vite only exposes variables that start with VITE_, and it bakes them into the
# built JavaScript — so NEVER put secrets (passwords, API keys) here. They would
# ship to every visitor's browser.

# The backend API this frontend talks to.
# Local dev: your Express server. Production: your deployed backend URL.
VITE_API_URL=http://localhost:8080
